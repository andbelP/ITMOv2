    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\n// Обрабатываем только открытие нового Issue\nif (body.action !== 'opened' || !body.issue) {\n  return [];\n}\n\nreturn [{\n  json: {\n    issue_number: body.issue.number,\n    title: body.issue.title || '',\n    body: body.issue.body || '',\n    user: body.issue.user ? body.issue.user.login : 'anonymous'\n  }\n}];"
      },
      "id": "b0000001-0001-4000-8000-000000000002",
