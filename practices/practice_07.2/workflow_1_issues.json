    {
      "parameters": {
        "jsCode": "const issueData = $('Filter opened issues').first().json;\nconst subResult = $input.first().json;\n\nconst rawType = subResult.type || subResult.classification || subResult.issue_type || subResult.category || 'unknown';\nconst type = String(rawType).toLowerCase().trim();\n\nlet conf = 0.5;\nif (typeof subResult.confidence === 'number') {\n  conf = subResult.confidence;\n} else if (subResult.confidence !== undefined) {\n  conf = parseFloat(subResult.confidence) || 0.5;\n}\n\n// Эскалация: confidence < 0.8 или неизвестный тип -> needs-triage\nlet route = 'needs-triage';\nif (conf >= 0.8 && ['bug', 'task', 'feature'].includes(type)) {\n  route = type;\n}\n\nreturn [{\n  json: {\n    issue_number: issueData.issue_number,\n    title: issueData.title,\n    body: issueData.body,\n    user: issueData.user,\n    type: type,\n    confidence: conf,\n    confidence_percent: Math.round(conf * 100),\n    route: route\n  }\n}];"
      },
