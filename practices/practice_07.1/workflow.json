    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// 1. Открытие или переоткрытие PR (основная модель)\nif (body.action === 'opened' || body.action === 'reopened') {\n  return [{ json: { pr_number: body.number, model_type: 'main' } }];\n}\n\n// 2. Команда /make_other_ai_review (вторая модель)\nif (body.action === 'created' && body.comment?.body?.includes('/make_other_ai_review')) {\n  return [{ json: { pr_number: body.issue.number, model_type: 'other' } }];\n}\n\n// 3. Команда /make_ai_review (основная модель)\nif (body.action === 'created' && body.comment?.body?.includes('/make_ai_review')) {\n  return [{ json: { pr_number: body.issue.number, model_type: 'main' } }];\n}\n\n// Игнорируем закрытие PR и любые другие комментарии\nreturn [];"
      },
